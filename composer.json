{
    "name": "pierre-granger/apidae-core",
    "description": "Apidae Core",
    "require": {
        "php": "^8.4",
        "phpmailer/phpmailer": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PierreGranger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PierreGranger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit -c phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    }
}